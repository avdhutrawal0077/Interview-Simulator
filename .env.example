# Google Gemini API Keys (Use distinct keys to avoid hitting rate limits, or reuse the same key)
GEMINI_API_KEY_QUESTION=your_gemini_api_key_for_question_generation_here
GEMINI_API_KEY_RESUME=your_gemini_api_key_for_resume_analysis_here
GEMINI_API_KEY_EVALUATION=your_gemini_api_key_for_evaluation_here
GEMINI_API_KEY_TRANSCRIBE=your_gemini_api_key_for_transcription_here
GEMINI_API_KEY=fallback_gemini_api_key_here


# Backend Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional Local Fallback (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b

# ─── Local STT (faster-whisper) ───────────────────────────────────────────────
# Model size: tiny.en | base.en | small.en | medium.en | large-v3 | large-v3-turbo
# Use "auto" to let the server pick best model for detected hardware.
STT_MODEL=large-v3-turbo
# Device: cuda (RTX GPU) | cpu
STT_DEVICE=cuda
# Compute type for CUDA: float16 | int8_float16 | int8
STT_COMPUTE_TYPE=float16
STT_LANGUAGE=en
STT_BEAM_SIZE=5
# Milliseconds of silence before an utterance is finalized
STT_ENDPOINT_SILENCE_MS=900
STT_INITIAL_PROMPT=Technical job interview: software engineering, algorithms, React, Python, system design, databases, cloud architecture.
