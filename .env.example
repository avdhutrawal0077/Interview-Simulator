# Google Gemini API Keys (Use distinct keys to avoid hitting rate limits, or reuse the same key)
GEMINI_API_KEY_QUESTION=your_gemini_api_key_for_question_generation_here
GEMINI_API_KEY_RESUME=your_gemini_api_key_for_resume_analysis_here
GEMINI_API_KEY_EVALUATION=your_gemini_api_key_for_evaluation_here
GEMINI_API_KEY=fallback_gemini_api_key_here


# Backend Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional Local Fallback (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b
